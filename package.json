{
  "name": "internway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "boundaries": "node scripts/check-boundaries.mjs",
    "gate": "biome ci . && tsc --noEmit && node scripts/check-boundaries.mjs && node scripts/check-i18n.mjs && vitest run && vite build",
    "collect": "python3 scripts/collect.py",
    "import:companies": ".venv/bin/python scripts/import_companies.py",
    "i18n": "node scripts/check-i18n.mjs",
    "setup:py": "python3 -m venv .venv && .venv/bin/pip install -r scripts/requirements.txt"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "axios": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "i18next": "^25",
    "lucide-react": "^0",
    "radix-ui": "^1.8.1",
    "react": "^19.2",
    "react-dom": "^19.2",
    "react-i18next": "^16",
    "tailwind-merge": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.3",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "jsdom": "^27",
    "tailwindcss": "^4",
    "typescript": "~5.9",
    "vite": "^7",
    "vitest": "^4"
  }
}
